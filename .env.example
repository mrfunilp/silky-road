# Copy this file to .env and fill in real values. .env is git-ignored.

# Secret that signs the login tokens (JWT). Must be at least 32 characters.
# Use a long random string, e.g. the output of: openssl rand -base64 48
SILKYROAD_JWT_SECRET=change-me-to-a-long-random-string-min-32-chars

# Password for the PostgreSQL database.
POSTGRES_PASSWORD=change-me
